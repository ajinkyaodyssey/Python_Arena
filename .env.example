# .env.example
# Copy this file to .env and fill in your values.
# .env is gitignored and never committed.
# .env.example IS committed — it shows what variables are needed
# without exposing actual values.

# reqres.in API key
# Get your free key at: app.reqres.in/api-keys
REQRES_API_KEY=your_api_key_here

# Test environment
# Options: staging, production, local
TEST_ENV=staging

# Base URLs (override if running against local server)
REQRES_BASE_URL=https://reqres.in/api

# Saucedemo credentials (not real secrets but good practice)
SAUCE_USERNAME=standard_user
SAUCE_PASSWORD=secret_sauce

# Reporting
REPORT_DIR=reports
SCREENSHOT_DIR=reports/screenshots