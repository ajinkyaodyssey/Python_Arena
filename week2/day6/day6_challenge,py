import functools
import time

# =============================================
# CHALLENGE 1: @timer
# =============================================
# Write a decorator called `timer` that:
# - Measures how long the decorated function takes to run
# - Prints: "  [func_name] completed in X.XXXXs"
# - Returns the original function's return value unchanged
# - Works on functions with any number of arguments
# - Preserves the original function's __name__ and __doc__

def timer(func):
    @functools.wraps(func)
    def wrapper(*args, **kwargs):
        start = time.perf_counter()
        return func(*args, **kwargs)
        elapsed = time.per_counter - start
        print(f"{func.__name__} completed in {elapsed:.4f}")
    return wrapper


# =============================================
# CHALLENGE 2: @retry
# =============================================
# Write a decorator factory called `retry` that takes:
# - max_attempts (int, default=3)
# - delay (float, default=0.5) - seconds to wait between attempts
# - exceptions (tuple, default=(Exception,)) - which exceptions to catch
#
# Behaviour:
# - Try calling the function
# - If it raises one of the specified exceptions, wait `delay` seconds and try again
# - If it succeeds, return the result immediately
# - If ALL attempts fail, raise the LAST exception that occurred
# - Print attempt number on each try: "  Attempt X/Y: func_name"

def retry(max_attempts=3, delay=0.5, exceptions=(Exception,)):
    def decorator(func):
        @functools.wraps(func)
        def wrapper(*args, **kwargs):
            last_exception = None
            for attempt in range(1, max_attempts+1):
                try:
                    print(f" Attempts {attempt}/{max_attempts}: {func.__name__}")
                    result = func(*args, **kwargs)
                    print(f"Success on attempt {attempt}")
                    return result
                    
                except exceptions as e:     #exceptions is one of the argument that we have defined, exceptions is just a variable holding a tuple of exception classes
                    last_exception = e
                    print(f" Failed: {e}")
                    if attempt < max_attempts:
                        time.sleep(delay)
                    else:
                        print(f"All {max_attempts} attempts failed")
                        raise last_exception
        return wrapper
    return decorator


