# Setup: counters to track how many times each function is called
attempt_tracker = {"flaky": 0, "always_fail": 0, "value_error": 0}

@retry(max_attempts=3, delay=0.01)
def flaky_function():
    """Fails twice then succeeds."""
    attempt_tracker["flaky"] += 1
    if attempt_tracker["flaky"] < 3:
        raise ConnectionError(f"Attempt {attempt_tracker['flaky']} failed")
    return "success after retries"

@retry(max_attempts=2, delay=0.01)
def always_fails():
    """Always raises an exception."""
    attempt_tracker["always_fail"] += 1
    raise TimeoutError("Always times out")

@retry(max_attempts=3, delay=0.01, exceptions=(ValueError,))
def only_retries_value_error():
    """Only retries on ValueError, not other exceptions."""
    attempt_tracker["value_error"] += 1
    raise TypeError("This should NOT be retried")

# Test 5: retry succeeds on third attempt
result = flaky_function()
assert result == "success after retries", "Test 5a failed"
assert attempt_tracker["flaky"] == 3, \
    f"Test 5b: expected 3 attempts, got {attempt_tracker['flaky']}"
print("TEST 5 PASSED: retry succeeds after failures")

# Test 6: retry raises last exception after all attempts fail
try:
